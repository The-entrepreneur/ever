model booking_events {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id       String    @db.Uuid
  booking_id     String?   @db.VarChar(50)
  guest_name     String?   @db.VarChar(255)
  room_type      String?   @db.VarChar(100)
  check_in       DateTime? @db.Date
  check_out      DateTime? @db.Date
  booking_value  Decimal?  @db.Decimal(10, 2)
  channel        String?   @db.VarChar(100)
  status         String    @default("confirmed") @db.VarChar(50)
  fee_percentage Decimal   @default(0.0300) @db.Decimal(5, 4)
  fee_amount     Decimal?  @default(dbgenerated("(booking_value * fee_percentage)")) @db.Decimal(10, 2)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  hotels         hotels    @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([hotel_id], map: "idx_booking_events_hotel")
}

