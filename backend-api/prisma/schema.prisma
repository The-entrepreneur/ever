/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model guests {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id             String     @db.Uuid
  full_name            String     @db.VarChar(255)
  first_name           String?    @db.VarChar(100)
  last_name            String?    @db.VarChar(100)
  email                String?    @db.VarChar(255)
  phone                String?    @db.VarChar(50)
  vip_tier             String     @default("standard") @db.VarChar(50)
  stay_count           Int        @default(0)
  total_spend          Decimal    @default(0.00) @db.Decimal(12, 2)
  room_preferences     Json       @default("[]")
  dietary_preferences  Json       @default("[]")
  special_notes        String?
  tags                 String[]   @default([])
  last_stay_at         DateTime?  @db.Timestamptz(6)
  last_contact_channel String?    @db.VarChar(50)
  created_at           DateTime   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime   @default(now()) @db.Timestamptz(6)
  bookings             bookings[]
  hotels               hotels     @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders               orders[]

  @@index([hotel_id, email], map: "idx_guests_email")
  @@index([hotel_id], map: "idx_guests_hotel_id")
  @@index([hotel_id, phone], map: "idx_guests_phone")
  @@index([hotel_id, vip_tier], map: "idx_guests_vip")
}

