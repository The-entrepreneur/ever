  hotel_id               String?              @db.Uuid
  email                  String               @unique @db.VarChar(255)
  full_name              String?              @db.VarChar(255)
  role                   staff_role           @default(hotel_receptionist)
  status                 String?              @default("active") @db.VarChar(50)
  receive_handoff_alerts Boolean?             @default(true)
  online_status          Boolean?             @default(false)
  last_login             DateTime?            @db.Timestamp(6)
  created_at             DateTime?            @default(now()) @db.Timestamp(6)
  mobile_number          String?              @db.VarChar(50)
  business_address       String?
  property_type          String?              @db.VarChar(100)
  pms                    String?              @db.VarChar(100)
  department             String?              @db.VarChar(50)
  shift                  String?              @db.VarChar(20)
  duty_status            String?              @db.VarChar(20)
  audit_log              audit_log[]
  notifications          notifications[]
  push_subscriptions     push_subscriptions[]
  support_tickets        support_tickets[]
  hotels                 hotels?              @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model whatsapp_accounts {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String?   @db.Uuid
  phone_number     String?   @db.VarChar(20)
  phone_number_id  String?   @db.VarChar(100)
  waba_id          String?   @db.VarChar(100)
  display_name     String?   @db.VarChar(255)
  status           String?   @default("pending") @db.VarChar(50)
  connected_via    String?   @default("openbsp_embedded") @db.VarChar(50)
  openbsp_token_id String?   @db.VarChar(255)
  verify_token     String?
  access_token     String?
  callback_url     String?
  connected_at     DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @db.Timestamp(6)
  hotels           hotels?   @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hotel_id, phone_number], map: "idx_whatsapp_accounts_hotel_phone")
  @@index([hotel_id], map: "idx_whatsapp_accounts_hotel_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model knowledge_embeddings {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id          String                 @db.Uuid
  source_id         String?                @db.Uuid
  content           String
  embedding         Unsupported("vector")?
  metadata          Json?                  @default("{}")
  created_at        DateTime?              @default(now()) @db.Timestamp(6)
  hotels            hotels                 @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledge_sources knowledge_sources?     @relation(fields: [source_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

