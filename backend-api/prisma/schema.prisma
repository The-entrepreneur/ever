/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model support_tickets {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id                String?                   @db.Uuid
  creator_id              String?                   @db.Uuid
  creator_name            String?                   @db.VarChar(255)
  creator_email           String                    @db.VarChar(255)
  category                String                    @default("General Inquiry") @db.VarChar(100)
  priority                String                    @default("normal") @db.VarChar(50)
  status                  String                    @default("open") @db.VarChar(50)
  subject                 String                    @db.VarChar(255)
  description             String
  assigned_to             String?                   @default("Ever Engineering & Operations Desk") @db.VarChar(100)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  support_ticket_messages support_ticket_messages[]
  users                   users?                    @relation(fields: [creator_id], references: [id], onUpdate: NoAction)
  hotels                  hotels?                   @relation(fields: [hotel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([hotel_id], map: "idx_support_tickets_hotel_id")
  @@index([status], map: "idx_support_tickets_status")
}

enum booking_status {
  Confirmed
  Pending
  Cancelled
}

enum order_category {
  Room_Service @map("Room Service")
  Housekeeping
  Maintenance
}

enum order_status {
  Pending
  Preparing
  Completed
}

enum staff_role {
  super_admin
  agency_staff
  hotel_manager
  hotel_receptionist
  hotel_readonly
}

enum subscription_status {
  trial
  active
  past_due
  canceled
}
