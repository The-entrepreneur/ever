# ─────────────────────────────────────────────────────────────
# EVER Platform — Client Environment Configuration Template
# Standardized Single Architecture: Ever Guest OS
# Usage: Populated automatically per tenant by new-client.sh
# ─────────────────────────────────────────────────────────────

# ─── Tenant Identity ─────────────────────────────────────────
HOTEL_NAME="Hotel Name"
HOTEL_SLUG="hotel-slug"
HOTEL_CURRENCY="GBP"
HOTEL_ADDRESS="Hotel Physical Address"
HOTEL_PHONE="+440000000000"
HOTEL_OPS_EMAIL="operations@yourdomain.com"
HOTEL_TIMEZONE="Europe/London"

# ─── Port Allocation ─────────────────────────────────────────
N8N_PORT=5678
BOT_ENGINE_PORT=3001
PMS_PORT=8000

# ─── Webhook & Gateway URLs ──────────────────────────────────
WEBHOOK_BASE_URL="https://${HOTEL_SLUG}.getever.com.ng"

# ─── Internal Service Security ───────────────────────────────
INTERNAL_API_KEY="generate_strong_random_key_min_32_chars"

# ─── Redis Cache & Handoff Lock ──────────────────────────────
REDIS_URL="redis://redis_${HOTEL_SLUG}:6379"
SESSION_TTL_MINUTES=60
HANDOFF_TIMEOUT_MINUTES=30

# ─── Supabase Data Layer (Single Source of Truth) ────────────
SUPABASE_URL="https://oieidnsppwooknzofzeq.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
PMS_DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.oieidnsppwooknzofzeq.supabase.co:5432/postgres"

# ─── AI Orchestration (Grok / ONNX Local RAG) ────────────────
GROK_API_KEY="your_xai_grok_api_key_here"
GROK_MODEL="grok-beta"

# ─── n8n Authentication ──────────────────────────────────────
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="generate_strong_password_here"

# ─── OpenBSP Messaging Gateway ───────────────────────────────
OPENBSP_BASE_URL="https://api.openbsp.dev"
OPENBSP_PUBLISHABLE_KEY="your_openbsp_publishable_key_here"
OPENBSP_OWNER_API_KEY="your_openbsp_owner_api_key_here"

# ─── Payment Gateway ─────────────────────────────────────────
PAYMENT_PROVIDER="paystack"
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_your_flutterwave_secret_key"
FLUTTERWAVE_SECRET_HASH="your_flutterwave_webhook_secret_hash"
